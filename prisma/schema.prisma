generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum BookingType {
  HOTEL
  FLIGHT
  TRAIN
}

model User {
  id                String    @id @default(cuid())
  email             String?   @unique
  phone             String?   @unique
  password          String
  role              UserRole  @default(USER)
  firstName         String?
  lastName          String?
  nationalId        String?   @unique
  address           String?
  postalCode        String?
  city              String?
  province          String?
  dateOfBirth       DateTime?
  emailVerified     Boolean   @default(false)
  phoneVerified     Boolean   @default(false)
  resetToken        String?
  resetTokenExpiry  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  bookings          Booking[]
  posts             Post[]
  
  createdPanels Panel[]
  panelUser PanelUser[]
  creditTransactions CreditTransaction[]

  @@index([email])
  @@index([phone])
}

model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String   @db.Text
  coverImage  String
  category    String
  tags        String[]
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  views       Int      @default(0)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([slug])
  @@index([published])
  @@index([featured])
  @@index([category])
}

model Booking {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            BookingType
  status          BookingStatus @default(PENDING)
  
  // Common fields
  bookingCode     String        @unique
  totalPrice      Float
  currency        String        @default("IRR")
  
  // Hotel specific
  hotelId         String?
  hotelName       String?
  roomType        String?
  checkIn         DateTime?
  checkOut        DateTime?
  guests          Int?
  
  // Flight specific
  flightId        String?
  flightNumber    String?
  airline         String?
  origin          String?
  destination     String?
  departureTime   DateTime?
  arrivalTime     DateTime?
  passengers      Int?
  class           String?
  
  // Train specific
  trainId         String?
  trainNumber     String?
  trainOrigin     String?
  trainDestination String?
  departureDate   DateTime?
  arrivalDate     DateTime?
  trainPassengers Int?
  wagonType       String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([userId])
  @@index([bookingCode])
  @@index([type])
  @@index([status])
}

model Hotel {
  id          String   @id @default(cuid())
  name        String
  city        String
  address     String
  rating      Float
  stars       Int
  image       String
  price       Float
  amenities   String[]
  description String   @db.Text
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([city])
  @@index([available])
}

model Flight {
  id            String   @id @default(cuid())
  flightNumber  String   @unique
  airline       String
  origin        String
  destination   String
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  available     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([origin, destination])
  @@index([available])
}

model Train {
  id            String   @id @default(cuid())
  trainNumber   String   @unique
  origin        String
  destination   String
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  wagonType     String
  available     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([origin, destination])
  @@index([available])
}

enum TransactionType {
  DEPOSIT    // واریز اعتبار
  WITHDRAW   // برداشت اعتبار
  CHARGE     // شارژ (کسر اعتبار)
  REFUND     // بازگشت اعتبار
  BONUS      // اعتبار هدیه
}

model Panel {
  id String @id @default(cuid())
  name String
  description String?
  slug String @unique
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminId String?
  user User? @relation(fields: [adminId], references: [id], onDelete: NoAction)
  panelStats PanelStats[]

  panelUser PanelUser[]
  creditTransactions CreditTransaction[]
  userTransactions UserTransaction[]
  panelActivityLog PanelActivityLog[]
}


model PanelUser {
  id        String   @id @default(cuid())
  credit    Int      @default(0)
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())
  lastLogin DateTime?

  // ارتباط با پنل
  panelId   String 
  panel     Panel    @relation(fields: [panelId], references: [id])

  // ارتباط با تراکنش‌های کاربر
  transactions UserTransaction[]
  panelActivityLog PanelActivityLog[]
  // ارتباط با کاربر اصلی (اگر ثبت‌نام کرده باشد)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // هر کاربر فقط یک بار می‌تواند در یک پنل باشد
  @@unique([panelId])
  @@index([panelId])
  @@index([isActive])
  @@index([joinedAt])
  @@map("panel_users")
}


model CreditTransaction {
  id          String      @id @default(cuid())
  type        TransactionType
  amount      Int
  description String?
  createdAt   DateTime    @default(now())

  // ارتباط با پنل
  panelId     String
  panel       Panel?       @relation(fields: [panelId], references: [id], onDelete: Cascade)

  // ارتباط با ادمین ایجادکننده تراکنش
  userId     String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([panelId])
  @@index([createdAt])
  @@index([type])
  @@map("credit_transactions")
}

model UserTransaction {
  id          String      @id @default(cuid())
  type        TransactionType
  amount      Int
  description String?
  createdAt   DateTime    @default(now())

  // ارتباط با کاربر پنل
  userId      String
  panelUser   PanelUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ارتباط با پنل (برای کوئری‌های بهینه)
  panelId     String
  panel       Panel?       @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([panelId])
  @@index([createdAt])
  @@index([type])
  @@map("user_transactions")
}

model PanelActivityLog {
  id        String   @id @default(cuid())
  action    String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  // ارتباط با پنل
  panelId   String
  panel     Panel    @relation(fields: [panelId], references: [id], onDelete: Cascade)

  // ارتباط با کاربر (اگر عمل توسط کاربر انجام شده)
  userId    String?
  panelUser PanelUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([panelId])
  @@index([createdAt])
  @@map("panel_activity_logs")
}

model PanelStats {
  id String @id @default(cuid())

  // آمار استفاده
  totalUsers      Int @default(0)
  activeUsers     Int @default(0)
  totalCreditUsed Int? @default(0)
  monthlyUsage    Int? @default(0)

  // تاریخ آمار (برای گزارش‌های ماهانه)
  year  Int?
  month Int?

  // ارتباط با پنل
  panelId String
  panel   Panel  @relation(fields: [panelId], references: [id], onDelete: Cascade)

  // هر پنل فقط یک رکورد آمار برای هر ماه دارد
  @@unique([panelId, year, month])
  @@index([panelId])
  @@index([year, month])
  @@map("panel_stats")
}