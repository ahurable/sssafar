generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER // کاربر معمولی
  ADMIN // مدیر
  ACCOUNTANT //حسابدار 
  ROTO // نماینده سازمان
  ORGAN // ارگان یا سازمان
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum BookingType {
  HOTEL
  FLIGHT
  TRAIN
}

model User {
  id               String    @id @default(cuid())
  email            String?   @unique
  phone            String?   @unique
  password         String
  role             UserRole  @default(USER)
  firstName        String?
  lastName         String?
  nationalId       String?   @unique
  address          String?
  postalCode       String?
  city             String?
  province         String?
  dateOfBirth      DateTime?
  emailVerified    Boolean   @default(false)
  phoneVerified    Boolean   @default(false)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  bookings                Booking[]
  posts                   Post[]
  travelers               Traveler[]
  createdPanels           Panel[]
  panelUser               PanelUser[]
  panelMember             MembersOnPanel[]
  contracts               Contract[]
  creditTransactions      CreditTransaction[]
  panelCreditTransactions PanelCreditTransaction[]
  invoices                Invoice[]
  userCredit              Credit?
  userTransactions        UserTransaction[]
  otpCodes                OtpCode[]

  @@index([email])
  @@index([phone])
}

model OtpCode {
  id         String   @id @default(cuid())
  code       Int
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatdDate DateTime @default(now())
  expireDate DateTime
}

model Traveler {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  nationalId     String
  dateOfBirth    DateTime
  passportNumber String
  passportExpiry String
  phoneNumber    String?
  email          String?
  gender         Int?
  passengerType  Int?

  userId    String
  createdBy User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  excerpt    String
  content    String   @db.Text
  coverImage String
  images     String[] // Multiple images for the post
  category   String
  tags       String[]
  published  Boolean  @default(false)
  featured   Boolean  @default(false)
  views      Int      @default(0)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // New relations for additional features
  tables   PostTable[]
  metadata PostMetadata?

  @@index([slug])
  @@index([published])
  @@index([featured])
  @@index([category])
}

model PostTable {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text // HTML content for the table
  order     Int // Order of tables in the post
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([order])
}

model PostMetadata {
  id             String   @id @default(cuid())
  postId         String   @unique
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  readingTime    Int      @default(0) // in minutes
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Booking {
  id     String        @id @default(cuid())
  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   BookingType
  status BookingStatus @default(PENDING)

  // Common fields
  bookingCode        String   @unique
  totalPrice         Float
  currency           String   @default("IRR")
  bookingInformation Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  data               Json

  @@index([userId])
  @@index([bookingCode])
  @@index([type])
  @@index([status])
}

model Flight {
  id            String   @id @default(cuid())
  flightNumber  String   @unique
  airline       String
  origin        String
  destination   String
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  available     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([origin, destination])
  @@index([available])
}

model Train {
  id            String   @id @default(cuid())
  trainNumber   String   @unique
  origin        String
  destination   String
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  wagonType     String
  available     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([origin, destination])
  @@index([available])
}

model Tour {
  id          String          @id @default(cuid())
  title       String
  description String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean         @default(true)
  featured    Boolean         @default(false)
  city        String?
  // ارتباط با مدل‌های موجود
  prices      TourPrice[]
  itineraries TourItinerary[]
  routes      TourRoute[]
  rules       TourRule[]
  transports  TourTransport[]
  images      TourImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([featured])
  @@index([startDate, endDate])
  @@map("tours")
}

model TourImage {
  id        String  @id @default(cuid())
  tourId    String
  tour      Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  filename  String
  path      String // Full path like "/assets/images/tours/[tourId]/[filename]"
  isPrimary Boolean @default(false)
  order     Int     @default(0)
  altText   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tourId])
  @@index([isPrimary])
  @@index([order])
  @@map("tour_images")
}

model TourPrice {
  id     String @id @default(cuid())
  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  type        PriceType
  price       Float
  description String?

  createdAt DateTime @default(now())

  @@map("tour_prices")
}

model TourItinerary {
  id     String @id @default(cuid())
  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  day         Int
  title       String
  description String
  activities  Json?

  createdAt DateTime @default(now())

  @@map("tour_itineraries")
}

model TourRoute {
  id     String @id @default(cuid())
  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  order       Int
  city        String
  country     String
  duration    Int?
  description String?

  createdAt DateTime @default(now())

  @@map("tour_routes")
}

model TourRule {
  id     String @id @default(cuid())
  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  title       String
  description String

  createdAt DateTime @default(now())

  @@map("tour_rules")
}

model TourTransport {
  id     String @id @default(cuid())
  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  type         TransportType
  departure    DateTime
  arrival      DateTime
  fromCity     String
  toCity       String
  carrier      String?
  flightNumber String?
  trainNumber  String?

  createdAt DateTime @default(now())

  @@map("tour_transports")
}

model CityTour {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String
  shortDescription String
  city             String
  location         String
  latitude         Float?
  longitude        Float?
  meetingPoint     String
  meetingLatitude  Float?
  meetingLongitude Float?
  duration         Int // in minutes
  maxCapacity      Int
  featured         Boolean  @default(false)
  isActive         Boolean  @default(true)
  images           String[]

  prices      CityTourPrice[]
  inclusions  CityTourInclusion[]
  exclusions  CityTourExclusion[]
  itineraries CityTourItinerary[]
  bookings    Reservation[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("city_tours")
}

model CityTourPrice {
  id       String   @id @default(cuid())
  type     String // adult, child, infant, etc.
  price    Int
  currency String   @default("IRR")
  tourId   String
  tour     CityTour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("city_tour_prices")
}

model CityTourInclusion {
  id     String   @id @default(cuid())
  item   String
  tourId String
  tour   CityTour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@map("city_tour_inclusions")
}

model CityTourExclusion {
  id     String   @id @default(cuid())
  item   String
  tourId String
  tour   CityTour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@map("city_tour_exclusions")
}

model CityTourItinerary {
  id          String   @id @default(cuid())
  order       Int
  title       String
  description String
  duration    Int // in minutes
  tourId      String
  tour        CityTour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@map("city_tour_itineraries")
}

// اضافه کردن enumهای لازم
enum PriceType {
  ADULT
  CHILD
  INFANT
  STUDENT
  SENIOR
}

enum TransportType {
  FLIGHT
  TRAIN
  BUS
  FERRY
}

enum TransactionType {
  DEPOSIT // واریز اعتبار
  WITHDRAW // برداشت اعتبار
  CHARGE // شارژ (کسر اعتبار)
  REFUND // بازگشت اعتبار
  BONUS // اعتبار هدیه
}

model Panel {
  id                 String       @id @default(cuid())
  name               String
  description        String?
  slug               String       @unique
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  discountPercentage Int          @default(0)
  totalCredit        Int          @default(0)
  adminId            String?
  user               User?        @relation(fields: [adminId], references: [id], onDelete: NoAction)
  panelStats         PanelStats[]
  contractId         String?      @unique
  contract           Contract?    @relation(fields: [contractId], references: [id])

  panelUser          PanelUser[]
  members            MembersOnPanel[]
  creditTransactions PanelCreditTransaction[]
  userTransactions   UserTransaction[]
  panelActivityLog   PanelActivityLog[]
}

enum PanelRole {
  ADMIN
  ECO
  ACC
}

model PanelUser {
  id        String                           @id @default(cuid())
  isActive  Boolean                          @default(true)
  joinedAt  DateTime                         @default(now())
  lastLogin DateTime?
  role      PanelRole                        @default(ADMIN)
  approvals PanelCreditTransactionApproval[]
  // ارتباط با پنل
  panelId   String
  panel     Panel                            @relation(fields: [panelId], references: [id])

  // ارتباط با تراکنش‌های کاربر
  // transactions UserTransaction[]
  panelActivityLog PanelActivityLog[]
  // ارتباط با کاربر اصلی (اگر ثبت‌نام کرده باشد)
  userId           String?
  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  // ✅ Fix: Allow multiple users per panel, but each user can only have one role per panel
  @@unique([panelId, userId])
  @@unique([panelId, role]) // Each role can only be assigned to one user per panel
  @@index([panelId])
  @@index([isActive])
  @@index([joinedAt])
  @@map("panel_users")
}

model MembersOnPanel {
  id        String    @id @default(cuid())
  credit    Int       @default(0)
  isActive  Boolean   @default(true)
  joinedAt  DateTime  @default(now())
  lastLogin DateTime?
  // ارتباط با پنل
  panelId   String
  panel     Panel     @relation(fields: [panelId], references: [id], onDelete: Cascade)

  // ارتباط با تراکنش‌های کاربر
  // transactions UserTransaction[]
  // panelActivityLog PanelActivityLog[]
  // ارتباط با کاربر اصلی (اگر ثبت‌نام کرده باشد)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // هر کاربر فقط یک بار می‌تواند در یک پنل باشد
  @@unique([panelId, userId])
  @@index([panelId])
  @@index([userId])
  @@index([isActive])
  @@index([joinedAt])
  @@map("panel_members")
}

enum PanelCreditTransactionType {
  INCREAMENT
  DECREAMENT
  INITIAL
}

enum PanelCreditTransactionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model PanelCreditTransaction {
  id          String                           @id @default(cuid())
  amount      Decimal
  status      PanelCreditTransactionStatus
  type        PanelCreditTransactionType
  panelId     String
  userId      String
  requestedBy String // User ID who requested the transaction
  approvals   PanelCreditTransactionApproval[]
  panel       Panel                            @relation(fields: [panelId], references: [id])
  user        User                             @relation(fields: [userId], references: [id])
  createdAt   DateTime                         @default(now())
  updatedAt   DateTime                         @updatedAt

  @@index([panelId])
  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model PanelCreditTransactionApproval {
  id            String         @id @default(cuid())
  transactionId String
  panelUserId   String
  role          PanelRole
  status        ApprovalStatus @default(PENDING)
  approvedAt    DateTime?
  rejectedAt    DateTime?

  transaction PanelCreditTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  panelUser   PanelUser              @relation(fields: [panelUserId], references: [id])

  @@unique([transactionId, panelUserId])
  @@index([transactionId])
  @@index([panelUserId])
  @@index([status])
}

model CreditTransaction {
  id          String          @id @default(cuid())
  type        TransactionType
  amount      Int
  description String?
  createdAt   DateTime        @default(now())
  // ارتباط با پنل
  // panelId     String?
  // panel       Panel?       @relation(fields: [panelId], references: [id], onDelete: NoAction)

  // ارتباط با ادمین ایجادکننده تراکنش
  userId String
  user   User?  @relation(fields: [userId], references: [id], onDelete: NoAction)

  creditId String?
  credit   Credit? @relation(fields: [creditId], references: [id], onDelete: Cascade)

  // @@index([panelId])
  @@index([createdAt])
  @@index([type])
  @@map("credit_transactions")
}

model UserTransaction {
  id          String          @id @default(cuid())
  type        TransactionType
  amount      Int
  description String?
  createdAt   DateTime        @default(now())

  // ارتباط با کاربر پنل
  userId String
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ارتباط با پنل (برای کوئری‌های بهینه)
  panelId String?
  panel   Panel?  @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([panelId])
  @@index([createdAt])
  @@index([type])
  @@map("user_transactions")
}

model PanelActivityLog {
  id        String   @id @default(cuid())
  action    String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  // ارتباط با پنل
  panelId String
  panel   Panel  @relation(fields: [panelId], references: [id], onDelete: Cascade)

  // ارتباط با کاربر (اگر عمل توسط کاربر انجام شده)
  userId    String?
  panelUser PanelUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([panelId])
  @@index([createdAt])
  @@map("panel_activity_logs")
}

model PanelStats {
  id String @id @default(cuid())

  // آمار استفاده
  totalUsers      Int  @default(0)
  activeUsers     Int  @default(0)
  totalCreditUsed Int? @default(0)
  monthlyUsage    Int? @default(0)

  // تاریخ آمار (برای گزارش‌های ماهانه)
  year  Int?
  month Int?

  // ارتباط با پنل
  panelId String
  panel   Panel  @relation(fields: [panelId], references: [id], onDelete: Cascade)

  // هر پنل فقط یک رکورد آمار برای هر ماه دارد
  @@unique([panelId, year, month])
  @@index([panelId])
  @@index([year, month])
  @@map("panel_stats")
}

model Credit {
  id        String   @id @default(cuid())
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions CreditTransaction[]

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

enum ContractStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model Contract {
  id               String         @id @default(cuid())
  title            String
  description      String?
  organizationName String
  status           ContractStatus @default(DRAFT)
  closeReason      String?
  files            File[] // Relation to multiple files
  userId           String
  createdBy        User           @relation(fields: [userId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  panel            Panel?

  @@map("contracts")
}

model File {
  id         String   @id @default(cuid())
  filename   String
  mimetype   String
  path       String // File path on disk or cloud URL
  size       Int // File size in bytes
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId String
  createdAt  DateTime @default(now())

  @@map("files")
}

model PartoSessionId {
  id        String   @id @default(cuid())
  session   String?
  createdAt DateTime @default(now())
  expiresAt DateTime
}

enum PaymentType {
  NO
  CREDIT
  STRAIGHT
  PANELCREDIT
}

enum InvoiceKind {
  HOTEL
  FLIGHT
  TRAIN
  CHARGE
  TOUR
}

enum InvoiceState {
  WAITING
  PAID
  CANCELLED
}

model Invoice {
  id               String       @id @default(cuid())
  type             PaymentType  @default(NO)
  kind             InvoiceKind
  amount           String
  state            InvoiceState
  selectedServices Json?
  order            Json?
  flightType       String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  flightSourceCode String?
  hotelIdentifier  String?
  trainIdentifier  String?

  createdAt DateTime @default(now())

  expireAt DateTime @default(now())

  travelers Json
}

// HERE IS FOR HOTELS STATIC DATA
model Hotel {
  id      Int       @id @default(autoincrement())
  hotelId Int       @unique
  name    String
  type    HotelType @default(INTERNATIONAL)

  // Relations
  images HotelImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId])
  @@index([name])
  @@index([type])
}

model HotelImage {
  id           Int       @id @default(autoincrement())
  hotelId      Int
  imageUrl     String
  thumbnailUrl String?
  type         ImageType @default(GALLERY)
  isDomestic   Boolean   @default(false)

  // Relations
  hotel Hotel @relation(fields: [hotelId], references: [hotelId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId])
  @@index([type])
  @@index([isDomestic])
}

enum HotelType {
  INTERNATIONAL
  DOMESTIC
}

enum ImageType {
  MAIN
  HERO
  GALLERY
  THUMBNAIL
}

model Airport {
  id          String  @id @default(cuid())
  name        String
  airportIata String?
  airportCity String?

  cipService CipService[]
}

model CipService {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  airport      Airport?      @relation(fields: [airportId], references: [id])
  airportId    String?
  description  String?
  content      Json?
  image        String?
  price        Float?
  currency     String        @default("IRR")
  duration     String?
  features     String[]
  included     String[]
  notIncluded  String[]
  priority     Int           @default(0)
  published    Boolean       @default(false)
  featured     Boolean       @default(false)
  entry        Boolean       @default(false)
  deferent     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]

  @@map("cip_services")
}

model Reservation {
  id          String   @id @default(cuid())
  serviceId   String?
  firstName   String
  lastName    String
  phoneNumber String
  status      String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service    CipService?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  cityTour   CityTour?    @relation(fields: [cityTourId], references: [id])
  cityTourId String?
  visa       VisaService? @relation(fields: [visaId], references: [id])
  visaId     String?

  @@map("cip_reservations")
}

model VisaService {
  id             String   @id @default(cuid())
  title          String
  slug           String?
  description    String?
  image          String?
  country        String
  city           String
  price          Float?
  currency       String   @default("ریال")
  processingTime String?
  validity       String?
  entryType      String
  features       String[]
  requirements   String[]
  documents      String[]
  priceTables    Json?
  priority       Int      @default(0)
  published      Boolean  @default(false)
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  faq      FAQ[]
  bookings Reservation[]

  @@map("visa_services")
}

// prisma/schema.prisma
enum FAQType {
  HOTEL
  AIR
  CIP
  TOUR
  CITY_TOUR
  VISA
  OTHER
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  type      FAQType
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visaId String?
  visa   VisaService? @relation(fields: [visaId], references: [id], onDelete: Cascade)

  @@map("faqs")
}
